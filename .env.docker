# Docker Configuration - Environment Variables
# Copy to .env and fill with your values

# Application
NODE_ENV=production

# Database
DB_USER=swiftpay_user
DB_PASSWORD=secure_postgres_password_change_this
DB_HOST=postgres
DB_PORT=5432
DB_NAME=swiftpay

# JWT
JWT_SECRET=your_super_secret_jwt_key_minimum_32_characters_long
JWT_EXPIRES_IN=7d

# Redis
REDIS_PASSWORD=secure_redis_password_change_this

# Email
GMAIL_USER=your_email@gmail.com
GMAIL_PASSWORD=your_app_specific_password

# Firebase
FIREBASE_CONFIG_PATH=./config/serviceAccountKey.json

# API Keys
OPEN_EXCHANGE_API_KEY=your_exchange_rate_api_key

# Logging
LOG_LEVEL=info

# Frontend
REACT_APP_API_URL=http://localhost/api
REACT_APP_ENVIRONMENT=production

# EAS/Expo
EXPO_PUBLIC_EAS_PROJECT_ID=your_eas_project_id

# Firebase Frontend
FIREBASE_API_KEY=your_firebase_api_key
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_STORAGE_BUCKET=your-project.appspot.com
FIREBASE_MESSAGING_SENDER_ID=your_sender_id
FIREBASE_APP_ID=your_app_id
